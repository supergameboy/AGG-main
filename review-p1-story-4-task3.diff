+    const matchedWrite = stagedInventoryWrites.find(write => {
+      const writeName = write.data.name;
+      if (this.isSameItemName(writeName, itemName)) {
+        return true;
+      }
+      if (matchedRow?.id && write.where?.id === matchedRow.id) {
+        return true;
+      }
+      return false;
