# Environment Variables

# Server Configuration
PORT=17334
NODE_ENV=development

# Database
DATABASE_PATH=./game_data/game.db

# LLM Model Configuration (Seeding Only)
# These variables are used to seed the default provider on first startup.
# After startup, manage model configuration through the frontend Settings page.
# Generic (recommended)
LLM_API_KEY=your_api_key_here
LLM_PROVIDER=deepseek
# LLM_BASE_URL=
# LLM_MODEL=
# DeepSeek (legacy, prefer LLM_API_KEY + LLM_PROVIDER=deepseek)
# DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com/anthropic
# DEEPSEEK_MODEL=deepseek-v4-flash

# Logging
LOG_LEVEL=info
LOG_DIR=./game_data/logs
