{
  "name": "@ai-rpg/backend",
  "version": "1.0.0",
  "description": "AI-generated Games 后端服务",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist *.tsbuildinfo",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:llm": "vitest run --config vitest.llm.config.ts",
    "generate:agent-help": "tsx scripts/generate-agent-help.ts"
  },
  "keywords": [
    "ai-rpg",
    "backend",
    "express"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@ai-rpg/ai": "workspace:*",
    "@ai-rpg/shared": "workspace:*",
    "@google/generative-ai": "^0.24.1",
    "@huggingface/transformers": "^4.2.0",
    "better-sqlite3": "^12.8.0",
    "chalk": "^5.6.2",
    "convict": "^6.2.5",
    "cors": "^2.8.5",
    "dotenv": "^16.4.1",
    "express": "^4.18.2",
    "ink": "^4.4.1",
    "ink-spinner": "^5.0.0",
    "ink-text-input": "^5.0.1",
    "js-yaml": "^4.1.1",
    "jsonrepair": "^3.14.0",
    "knex": "^3.1.0",
    "marked": "^18.0.2",
    "openai": "^6.33.0",
    "uuid": "^9.0.1",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0",
    "ws": "^8.16.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.8",
    "@types/convict": "^6.1.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.11.0",
    "@types/supertest": "^6.0.3",
    "@types/uuid": "^9.0.7",
    "@types/ws": "^8.5.10",
    "supertest": "^6.3.4",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vitest": "^1.6.1"
  }
}
